# EAS archives the whole monorepo from the git root, so this file must live at
# the repo root to take effect (a .easignore under apps/mobile is not applied to
# sibling workspaces). Only the mobile app is built via EAS.

# Keep all Yarn workspaces in the archive. Yarn runs with --immutable on EAS,
# so removing workspace directories changes the resolved lockfile.

# Keep config/* workspaces in the archive. apps/mobile depends on
# @repo/eslint-config, @repo/ts-config, and @repo/metadata via workspace:*,
# so Yarn must see those packages during EAS install.

# Large non-mobile assets that are not needed by the mobile build.
apps/desktop/bin/
apps/desktop/release/

# Repo docs / design
docs
design

# Dev / tooling
.claude
.github
.vscode
*.md
!README.md
node_modules/
apps/mobile/node_modules/
.yarn/cache/
.yarn/install-state.gz
.expo/
apps/mobile/.expo/

# Locally generated native projects. EAS should regenerate them from
# app.config.ts instead of uploading machine-local outputs.
apps/mobile/ios/
apps/mobile/android/

# Build cache & logs
.turbo/
coverage/
*.log

# Environment files
.env*

# Tests
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
