# Keep all Yarn workspaces in the archive. Yarn runs with --immutable on EAS,
# so removing workspace directories changes the resolved lockfile.

# Dev / tooling
.claude
.github
.vscode
*.md
!README.md
node_modules/
.expo/
ios/
android/

# Build cache & logs
.turbo/
coverage/
*.log

# Environment files
.env*

# Tests
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
